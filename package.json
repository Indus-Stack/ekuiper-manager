{
  "name": "ekuiper-manager",
  "version": "1.3.0",
  "description": "A self-hosted manager for eKuiper installations",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.20.0"
  },
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint src --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "ai:check": "node scripts/check-ai-tool-calling.mjs",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "db:migrate": "node scripts/migrate.mjs"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.5",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-avatar": "^1.3.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-table": "^9.3.1",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.53.0",
    "@typescript-eslint/parser": "^8.53.0",
    "autoprefixer": "^10.6.1",
    "dotenv": "^18.0.8",
    "eslint": "9.39.2",
    "eslint-config-next": "16.4.2",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "postcss": "8.5.30",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "tailwindcss-animate": "^1.0.7"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "hono": ">=4.12.7",
    "@hono/node-server": ">=1.19.10",
    "axios": ">=1.13.5",
    "ajv": "~6.14.0",
    "dompurify": ">=3.3.2",
    "immutable": "3.8.3",
    "lodash": ">=4.17.23",
    "flatted": ">=3.4.2",
    "effect": ">=3.20.0",
    "picomatch": ">=4.0.4",
    "brace-expansion": "5.0.12",
    "defu": ">=6.1.5",
    "js-yaml": "4.3.2",
    "nanoid": "3.3.18",
    "postcss": "8.5.30",
    "sharp": "0.35.5",
    "source-map-js": ">=1.2.2",
    "ws": "8.21.3",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "3.15.2"
    }
  }
}
